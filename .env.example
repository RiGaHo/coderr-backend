# Example only; Django reads exported environment variables, not this file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
# Production requires an unpredictable DJANGO_SECRET_KEY, DEBUG=false,
# explicit hosts and CSRF origins, HTTPS, and persistent data paths.
# Set DJANGO_TRUST_PROXY=true only behind a proxy that replaces forwarded headers.
